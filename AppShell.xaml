<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BlutdruckApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BlutdruckApp"
    xmlns:pages="clr-namespace:BlutdruckApp.Pages"
    Title="Blutdruck">

    <TabBar>
        <ShellContent Title="Verlauf" Icon="tab_verlauf.png"
                      ContentTemplate="{DataTemplate local:MainPage}" Route="verlauf" />
        <ShellContent Title="Daten" Icon="tab_daten.png"
                      ContentTemplate="{DataTemplate pages:DatenPage}" Route="daten" />
    </TabBar>

</Shell>
