<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BlutdruckApp.Pages.EintragPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="520">

            <Label Text="Zeitpunkt" Style="{StaticResource Feldname}" />
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                <DatePicker x:Name="Datum" Format="dd.MM.yyyy" FontSize="18" />
                <TimePicker x:Name="Zeit" Grid.Column="1" Format="HH:mm" FontSize="18" />
                <Button Grid.Column="2" Text="Jetzt" Clicked="OnJetzt" Padding="14,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </Grid>

            <!-- Messung -->
            <Grid x:Name="BereichMessung" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                <Label Text="SYS (oben)" Style="{StaticResource Feldname}" />
                <Label Grid.Column="1" Text="DIA (unten)" Style="{StaticResource Feldname}" />
                <Label Grid.Column="2" Text="Puls" Style="{StaticResource Feldname}" />
                <Entry x:Name="Sys" Grid.Row="1" Keyboard="Numeric" Placeholder="120" FontSize="24"
                       HorizontalTextAlignment="Center" MaxLength="3" ReturnType="Next" />
                <Entry x:Name="Dia" Grid.Row="1" Grid.Column="1" Keyboard="Numeric" Placeholder="80" FontSize="24"
                       HorizontalTextAlignment="Center" MaxLength="3" ReturnType="Next" />
                <Entry x:Name="Puls" Grid.Row="1" Grid.Column="2" Keyboard="Numeric" Placeholder="70" FontSize="24"
                       HorizontalTextAlignment="Center" MaxLength="3" ReturnType="Next" />
            </Grid>

            <!-- Einnahme -->
            <VerticalStackLayout x:Name="BereichEinnahme" Spacing="4">
                <Label Text="Medikament (optional)" Style="{StaticResource Feldname}" />
                <Entry x:Name="Medikament" Placeholder="z. B. Amlodipin 5 mg" FontSize="18" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Notiz (optional)" Style="{StaticResource Feldname}" />
                <Entry x:Name="Notiz" Placeholder="z. B. nach dem Aufstehen, linker Arm" FontSize="16" />
            </VerticalStackLayout>

            <Button Text="Speichern" Clicked="OnSpeichern" HeightRequest="52" FontSize="18" Margin="0,8,0,0" />
            <Button x:Name="BtnLoeschen" Text="Löschen" Clicked="OnLoeschen" BackgroundColor="Transparent"
                    TextColor="#C62828" BorderColor="#C62828" BorderWidth="1" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
